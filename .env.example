# Copy to .env and fill in. The service reads .env at start (the environment wins over it).
# MySQL database of the service: projects, engines, prompts and the job index. The tables are created on first start.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=synthetic_data
# Or any SQLAlchemy URL instead of the MYSQL_* lines:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/synthetic_data?charset=utf8mb4

# Optional: HTTP Basic auth over the whole service
# VG_USER=
# VG_PASSWORD=
